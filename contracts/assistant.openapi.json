        "type": "object"
      },
      "PackageDraft": {
        "description": "Bản nháp app.yaml và cấu hình của các mục menu, khối. Không có migration, quyền Hasura, BPMN hay văn\nbản, nên chưa cài được ngay; dịch vụ không ghi gì vào apps/, chỉ ghi một dòng nhật ký.",
        "properties": {
          "attempts": {
            "description": "Số lượt mô hình đã trả bản nháp: 1, hay 2 khi có lượt sửa trả về",
            "title": "Attempts",
            "type": "integer"
          },
          "choices": {
            "description": "Lý do chọn thành phần của từng mục menu hay khối",
            "items": {
              "$ref": "#/components/schemas/DraftChoice"
            },
            "title": "Choices",
            "type": "array"
          },
          "files": {
            "description": "Các tệp của bản nháp; rỗng khi refused",
            "items": {
              "$ref": "#/components/schemas/DraftFile"
            },
            "title": "Files",
            "type": "array"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelInfo"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mô hình đã soạn bản nháp"
          },
          "outcome": {
            "description": "drafted: mọi tệp qua bước kiểm; invalid: còn lỗi, xem `problems` và `reason`; refused: mô hình nói không soạn được bằng các thành phần hiện có",
            "enum": [
              "drafted",
              "invalid",
              "refused"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "problems": {
            "description": "Lỗi còn lại khi kiểm; rỗng khi drafted",
            "items": {
              "$ref": "#/components/schemas/DraftProblem"
            },
            "title": "Problems",
            "type": "array"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Lý do khi invalid hay refused, hiển thị được; null khi drafted",
            "title": "Reason"
          },
          "to_write": {
            "description": "Tệp app.yaml khai (quy trình, luật, văn bản, bảng thẩm quyền) mà bản nháp không có; viết trước khi cài. Không làm bản nháp thành invalid",
            "items": {
              "$ref": "#/components/schemas/DraftProblem"
            },
            "title": "To Write",
            "type": "array"
          }
        },
