{
  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Câu trả lời của mô hình; null khi từ chối",
            "title": "Answer"
          },
          "citations": {
            "description": "Câu làm căn cứ; rỗng khi từ chối",
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelInfo"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mô hình đã được hỏi; null khi từ chối mà không gọi mô hình (không có đoạn đủ gần)"
          },
          "outcome": {
            "enum": [
              "answered",
              "refused"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Lý do từ chối, hiển thị được cho người dùng; null khi trả lời",
            "title": "Reason"
          }
        },
        "required": [
          "outcome",
          "answer",
          "reason",
          "citations",
          "model"
        ],
        "title": "Answer",
        "type": "object"
      },
      "Citation": {
        "properties": {
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "label": {
            "description": "Vị trí của đoạn trong văn bản, lấy từ dữ liệu của gói",
            "title": "Label",
            "type": "string"
          },
          "passage_id": {
            "title": "Passage Id",
            "type": "string"
          },
          "sentence": {
            "description": "Câu nguyên văn trong dữ liệu, không phải chữ của mô hình",
            "title": "Sentence",
            "type": "string"
          },
          "title": {
            "description": "Tên văn bản",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "title",
          "passage_id",
          "label",
          "sentence"
        ],
        "title": "Citation",
        "type": "object"
      },
      "DataAnswer": {
        "description": "Kết quả của cả câu mẫu (`/data-queries`) và câu hỏi gõ tự do (`/data-questions`).",
        "properties": {
          "attempts": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Số lượt mô hình viết câu: 1, hay 2 khi guard từ chối câu đầu và mô hình viết lại; null với câu mẫu",
            "title": "Attempts"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelInfo"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mô hình đã viết câu truy vấn; null với câu mẫu (không qua mô hình)"
          },
          "outcome": {
            "enum": [
              "data",
              "refused"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "query": {
            "description": "Câu truy vấn đã chạy, hay câu bị từ chối; đúng chữ, không sửa. Chuỗi rỗng khi mô hình không viết câu nào (`refused_by` là `model`)",
            "title": "Query",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Lý do từ chối, hiển thị được cho người dùng; null khi có dữ liệu",
            "title": "Reason"
          },
          "refused_by": {
            "anyOf": [
              {
                "enum": [
                  "model",
                  "guard",
                  "hasura"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Bước đã từ chối câu hỏi gõ tự do: mô hình nói không trả lời được, guard chặn câu mô hình viết, hay Hasura từ chối câu đã qua guard; null khi có dữ liệu và với câu mẫu",
            "title": "Refused By"
          },
          "tables": {
            "description": "Bảng kết quả; rỗng khi từ chối",
            "items": {
              "$ref": "#/components/schemas/DataTable"
            },
            "title": "Tables",
            "type": "array"
          }
        },
        "required": [
          "outcome",
          "reason",
          "query",
          "tables",
          "model",
          "attempts",
          "refused_by"
        ],
        "title": "DataAnswer",
        "type": "object"
      },
      "DataColumn": {
        "properties": {
          "key": {
            "description": "Khóa của ô trong mỗi dòng: tên cột, hay <quan hệ>.<cột>",
            "title": "Key",
            "type": "string"
          },
          "label": {
            "description": "Tiêu đề cột lấy từ cấu hình của gói",
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "key",
          "label"
        ],
        "title": "DataColumn",
        "type": "object"
      },
      "DataQuery": {
        "additionalProperties": false,
        "description": "Câu hỏi dữ liệu (ADR 0027). Bảng, cột được phép không đi theo yêu cầu: dịch vụ đọc từ mục `item`.",
        "properties": {
          "app": {
            "description": "Gói của mục menu, hay `core` cho mục mẫu",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "App",
            "type": "string"
          },
          "item": {
            "description": "Mục menu `component: assistant` có khối `data`",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "Item",
            "type": "string"
          },
          "query": {
            "description": "Câu GraphQL chỉ đọc; phải qua guard (bảng, cột, toán tử, limit theo cấu hình của mục)",
            "maxLength": 4000,
            "title": "Query",
            "type": "string"
          },
          "question": {
            "description": "Câu hỏi hiện trên màn hình; độ dài tối đa: ASSISTANT_MAX_QUESTION_CHARS",
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question",
          "app",
          "item",
          "query"
        ],
        "title": "DataQuery",
        "type": "object"
      },
      "DataQuestion": {
        "additionalProperties": false,
        "description": "Câu hỏi dữ liệu gõ tự do (ADR 0034): mô hình viết câu truy vấn, câu qua cùng guard như `DataQuery`.",
        "properties": {
          "app": {
            "description": "Gói của mục menu, hay `core` cho mục mẫu",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "App",
            "type": "string"
          },
          "item": {
            "description": "Mục menu `component: assistant` có khối `data`",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "Item",
            "type": "string"
          },
          "question": {
            "description": "Câu hỏi người dùng gõ; độ dài tối đa: ASSISTANT_MAX_QUESTION_CHARS. Không gửi bảng hay câu truy vấn: dịch vụ đọc bảng, cột được phép từ mục `item` và mô hình viết câu.",
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question",
          "app",
          "item"
        ],
        "title": "DataQuestion",
        "type": "object"
      },
      "DataTable": {
        "properties": {
          "columns": {
            "items": {
              "$ref": "#/components/schemas/DataColumn"
            },
            "title": "Columns",
            "type": "array"
          },
          "rows": {
            "description": "Dòng Hasura trả về theo quyền người hỏi, nguyên giá trị; giao diện hiện như chữ thường",
            "items": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            "title": "Rows",
            "type": "array"
          },
          "title": {
            "description": "Tên bảng lấy từ cấu hình của gói",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "columns",
          "rows"
        ],
        "title": "DataTable",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "error": {
            "description": "Lý do bằng tiếng Việt, hiển thị được cho người dùng",
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ModelInfo": {
        "properties": {
          "host": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tên máy của API khi `location` là `api`; null khi chạy tại chỗ",
            "title": "Host"
          },
          "location": {
            "description": "local: Ollama trong mạng nội bộ của bản cài; api: câu hỏi và đoạn văn bản gửi tới `host`",
            "enum": [
              "local",
              "api"
            ],
            "title": "Location",
            "type": "string"
          },
          "name": {
            "description": "Tên mô hình mà nhà cung cấp nhận",
            "title": "Name",
            "type": "string"
          },
          "provider": {
            "description": "Cách gọi mô hình, do người vận hành chọn bằng ASSISTANT_LLM_PROVIDER",
            "enum": [
              "ollama",
              "openai-compatible"
            ],
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "name",
          "provider",
          "location",
          "host"
        ],
        "title": "ModelInfo",
        "type": "object"
      },
      "Question": {
        "additionalProperties": false,
        "properties": {
          "app": {
            "description": "Gói sở hữu văn bản, hay `core` cho văn bản mẫu",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "App",
            "type": "string"
          },
          "documents": {
            "description": "Mã văn bản được hỏi: `documents` của cấu hình trợ lý (contracts/assistant.schema.json)",
            "items": {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Documents",
            "type": "array"
          },
          "question": {
            "description": "Câu hỏi; độ dài tối đa do người vận hành đặt (ASSISTANT_MAX_QUESTION_CHARS)",
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question",
          "app",
          "documents"
        ],
        "title": "Question",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Mortise DX assistant API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/assistant/data-queries": {
      "post": {
        "description": "Chạy một câu GraphQL chỉ đọc trên các bảng mà mục menu `item` của gói `app` khai, bằng token người hỏi.\n\nCâu không qua guard hay bị Hasura từ chối thì `outcome` là `refused` kèm lý do và câu bị từ chối (mã\n200). Mục menu không có trong tenant của token, hay không hỏi dữ liệu, là 404. Mỗi câu được ghi nhật ký\nkèm câu truy vấn và số dòng, không kèm dòng; không ghi được thì trả 503 thay cho bảng.",
        "operationId": "data_queries_v1_assistant_data_queries_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DataQuery"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataAnswer"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Data Queries"
      }
    },
    "/v1/assistant/data-questions": {
      "post": {
        "description": "Trả lời câu hỏi dữ liệu gõ tự do: mô hình viết một câu GraphQL chỉ đọc, câu qua guard rồi chạy.\n\nMô hình chỉ nhận câu hỏi và mô tả bảng, cột của mục `item`, không nhận dòng dữ liệu. Guard từ chối thì\nmô hình được viết lại một lần theo lý do của guard. Mô hình nói không trả lời được, guard vẫn từ chối hay\nHasura từ chối thì `outcome` là `refused` kèm `refused_by` (mã 200). Mô hình chưa chạy hay đang bận là\n503, quá giờ ở lượt đầu là 504. Mỗi câu được ghi nhật ký kèm mô hình, câu truy vấn, số lượt và số dòng,\nkhông kèm dòng.",
        "operationId": "data_questions_v1_assistant_data_questions_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DataQuestion"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataAnswer"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        },
        "summary": "Data Questions"
      }
    },
    "/v1/assistant/questions": {
      "post": {
        "description": "Trả lời từ các văn bản được hỏi, chỉ trong các đoạn mà token người hỏi đọc được.\n\nKhông đủ căn cứ hay câu trả lời không qua bước kiểm thì `outcome` là `refused` kèm lý do (mã 200). Mỗi câu\nhỏi được ghi nhật ký; không ghi được thì trả 503 thay cho câu trả lời.",
        "operationId": "questions_v1_assistant_questions_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Question"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Answer"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
