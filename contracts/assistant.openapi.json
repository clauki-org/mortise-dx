          "capability",
          "why"
        ],
        "title": "DraftArgument",
        "type": "object"
      },
      "DraftChoice": {
        "properties": {
          "arguments": {
            "description": "Tối đa ba lập luận vì sao thành phần hợp với nhu cầu; lập luận có đoạn nhu cầu không có trong nhu cầu hay mã câu không có trong bản mô tả bị bỏ",
            "items": {
              "$ref": "#/components/schemas/DraftArgument"
            },
            "title": "Arguments",
            "type": "array"
          },
          "component": {
            "description": "Thành phần mục đó dùng, đọc từ app.yaml",
            "title": "Component",
            "type": "string"
          },
          "item": {
            "description": "id của mục menu hay khối trong app.yaml",
            "title": "Item",
            "type": "string"
          }
        },
        "required": [
