{
  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Câu trả lời của mô hình; null khi từ chối",
            "title": "Answer"
          },
          "citations": {
            "description": "Câu làm căn cứ; rỗng khi từ chối",
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "outcome": {
            "enum": [
              "answered",
              "refused"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Lý do từ chối, hiển thị được cho người dùng; null khi trả lời",
            "title": "Reason"
          }
        },
        "required": [
          "outcome",
          "answer",
          "reason",
          "citations"
        ],
        "title": "Answer",
        "type": "object"
      },
      "Citation": {
        "properties": {
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "label": {
            "description": "Vị trí của đoạn trong văn bản, lấy từ dữ liệu của gói",
            "title": "Label",
            "type": "string"
          },
          "passage_id": {
            "title": "Passage Id",
            "type": "string"
          },
          "sentence": {
            "description": "Câu nguyên văn trong dữ liệu, không phải chữ của mô hình",
            "title": "Sentence",
            "type": "string"
          },
          "title": {
            "description": "Tên văn bản",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "title",
          "passage_id",
          "label",
          "sentence"
        ],
        "title": "Citation",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "error": {
            "description": "Lý do bằng tiếng Việt, hiển thị được cho người dùng",
            "title": "Error",
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Question": {
        "additionalProperties": false,
        "properties": {
          "app": {
            "description": "Gói sở hữu văn bản, hay `core` cho văn bản mẫu",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "App",
            "type": "string"
          },
          "documents": {
            "description": "Mã văn bản được hỏi: `documents` của cấu hình trợ lý (contracts/assistant.schema.json)",
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Documents",
            "type": "array"
          },
          "question": {
            "description": "Câu hỏi; độ dài tối đa do người vận hành đặt (ASSISTANT_MAX_QUESTION_CHARS)",
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question",
          "app",
          "documents"
        ],
        "title": "Question",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Mortise DX assistant API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/assistant/questions": {
      "post": {
        "description": "Trả lời từ các văn bản được hỏi, chỉ trong các đoạn mà token người hỏi đọc được.\n\nKhông đủ căn cứ hay câu trả lời không qua bước kiểm thì `outcome` là `refused` kèm lý do (mã 200).",
        "operationId": "questions_v1_assistant_questions_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Question"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Answer"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        },
        "summary": "Questions"
      }
    }
  }
}
