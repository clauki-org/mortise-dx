{
  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Câu trả lời của mô hình; null khi từ chối",
            "title": "Answer"
          },
          "citations": {
            "description": "Câu làm căn cứ; rỗng khi từ chối",
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelInfo"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mô hình đã được hỏi; null khi từ chối mà không gọi mô hình (không có đoạn đủ gần)"
          },
          "outcome": {
            "enum": [
              "answered",
              "refused"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Lý do từ chối, hiển thị được cho người dùng; null khi trả lời",
            "title": "Reason"
          }
        },
        "required": [
          "outcome",
          "answer",
          "reason",
          "citations",
          "model"
        ],
        "title": "Answer",
        "type": "object"
      },
      "Citation": {
        "properties": {
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "label": {
            "description": "Vị trí của đoạn trong văn bản, lấy từ dữ liệu của gói",
            "title": "Label",
            "type": "string"
          },
          "passage_id": {
            "title": "Passage Id",
            "type": "string"
          },
          "sentence": {
            "description": "Câu nguyên văn trong dữ liệu, không phải chữ của mô hình",
            "title": "Sentence",
            "type": "string"
          },
          "title": {
            "description": "Tên văn bản",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "title",
          "passage_id",
          "label",
          "sentence"
        ],
        "title": "Citation",
        "type": "object"
      },
      "DataAnswer": {
        "description": "Kết quả của cả câu mẫu (`/data-queries`) và câu hỏi gõ tự do (`/data-questions`).",
        "properties": {
          "attempts": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Số lượt mô hình viết câu: 1, hay 2 khi guard từ chối câu đầu và mô hình viết lại; null với câu mẫu",
            "title": "Attempts"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelInfo"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mô hình đã viết câu truy vấn; null với câu mẫu (không qua mô hình)"
          },
          "outcome": {
            "enum": [
              "data",
              "refused"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "query": {
            "description": "Câu truy vấn đã chạy, hay câu bị từ chối; đúng chữ, không sửa. Chuỗi rỗng khi mô hình không viết câu nào (`refused_by` là `model`)",
            "title": "Query",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Lý do từ chối, hiển thị được cho người dùng; null khi có dữ liệu",
            "title": "Reason"
          },
          "refused_by": {
            "anyOf": [
              {
                "enum": [
                  "model",
                  "guard",
                  "hasura"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Bước đã từ chối câu hỏi gõ tự do: mô hình nói không trả lời được, guard chặn câu mô hình viết, hay Hasura từ chối câu đã qua guard; null khi có dữ liệu và với câu mẫu",
            "title": "Refused By"
          },
          "tables": {
            "description": "Bảng kết quả; rỗng khi từ chối",
            "items": {
              "$ref": "#/components/schemas/DataTable"
            },
            "title": "Tables",
            "type": "array"
          }
        },
        "required": [
          "outcome",
          "reason",
          "query",
          "tables",
          "model",
          "attempts",
          "refused_by"
        ],
        "title": "DataAnswer",
        "type": "object"
      },
      "DataColumn": {
        "properties": {
          "key": {
            "description": "Khóa của ô trong mỗi dòng: tên cột, hay <quan hệ>.<cột>",
            "title": "Key",
            "type": "string"
          },
          "label": {
            "description": "Tiêu đề cột lấy từ cấu hình của gói",
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "key",
          "label"
        ],
        "title": "DataColumn",
        "type": "object"
      },
      "DataQuery": {
        "additionalProperties": false,
        "description": "Câu hỏi dữ liệu (ADR 0027). Bảng, cột được phép không đi theo yêu cầu: dịch vụ đọc từ mục `item`.",
        "properties": {
          "app": {
            "description": "Gói của mục menu, hay `core` cho mục mẫu",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "App",
            "type": "string"
          },
          "item": {
            "description": "Mục menu `component: assistant` có khối `data`",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "Item",
            "type": "string"
          },
          "query": {
            "description": "Câu GraphQL chỉ đọc; phải qua guard (bảng, cột, toán tử, limit theo cấu hình của mục)",
            "maxLength": 4000,
            "title": "Query",
            "type": "string"
          },
          "question": {
            "description": "Câu hỏi hiện trên màn hình; độ dài tối đa: ASSISTANT_MAX_QUESTION_CHARS",
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question",
          "app",
          "item",
          "query"
        ],
        "title": "DataQuery",
        "type": "object"
      },
      "DataQuestion": {
        "additionalProperties": false,
        "description": "Câu hỏi dữ liệu gõ tự do (ADR 0034): mô hình viết câu truy vấn, câu qua cùng guard như `DataQuery`.",
        "properties": {
          "app": {
            "description": "Gói của mục menu, hay `core` cho mục mẫu",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "App",
            "type": "string"
          },
          "item": {
            "description": "Mục menu `component: assistant` có khối `data`",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "Item",
            "type": "string"
          },
          "question": {
            "description": "Câu hỏi người dùng gõ; độ dài tối đa: ASSISTANT_MAX_QUESTION_CHARS. Không gửi bảng hay câu truy vấn: dịch vụ đọc bảng, cột được phép từ mục `item` và mô hình viết câu.",
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question",
          "app",
          "item"
        ],
        "title": "DataQuestion",
        "type": "object"
      },
      "DataTable": {
        "properties": {
          "columns": {
            "items": {
              "$ref": "#/components/schemas/DataColumn"
            },
            "title": "Columns",
            "type": "array"
          },
          "rows": {
            "description": "Dòng Hasura trả về theo quyền người hỏi, nguyên giá trị; giao diện hiện như chữ thường",
            "items": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            "title": "Rows",
            "type": "array"
          },
          "title": {
            "description": "Tên bảng lấy từ cấu hình của gói",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "columns",
          "rows"
        ],
        "title": "DataTable",
        "type": "object"
      },
      "DraftArgument": {
        "properties": {
          "capability": {
            "description": "Câu nguyên văn trong contracts/<thành phần>.component.yaml mô tả công dụng đáp ứng đoạn đó; dịch vụ chép theo mã mô hình chỉ ra",
            "title": "Capability",
            "type": "string"
          },
          "need": {
            "description": "Đoạn của nhu cầu mà lập luận dựa vào; dịch vụ đã kiểm có trong nhu cầu",
            "title": "Need",
            "type": "string"
          },
          "why": {
            "description": "Câu mô hình viết nối đoạn nhu cầu với công dụng; không qua bước kiểm nào",
            "title": "Why",
            "type": "string"
          }
        },
        "required": [
