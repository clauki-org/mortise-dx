  "info": {
    "title": "Mortise DX workflow API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/workflow/cases": {
      "get": {
        "description": "Hồ sơ do người gọi lập trong tenant của mình, mới nhất trước, kèm bước đang chờ.",
        "operationId": "my_cases_v1_workflow_cases_get",
        "parameters": [
          {
            "description": "Chỉ hồ sơ của các quy trình này; bỏ trống là mọi quy trình",
            "in": "query",
            "name": "process",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,254}$",
                    "type": "string"
                  },
                  "maxItems": 20,
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Chỉ hồ sơ của các quy trình này; bỏ trống là mọi quy trình",
              "title": "Process"
            }
          },
          {
            "description": "Hồ sơ còn mở, đã kết thúc hay cả hai",
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "default": "all",
              "description": "Hồ sơ còn mở, đã kết thúc hay cả hai",
              "enum": [
                "open",
                "ended",
                "all"
              ],
              "title": "State",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 100000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "description": "Chỉ tài khoản dịch vụ gửi: tenant mà dịch vụ mở quy trình thay (ADR 0017)",
            "in": "header",
            "name": "X-Mortise-Tenant",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Chỉ tài khoản dịch vụ gửi: tenant mà dịch vụ mở quy trình thay (ADR 0017)",
              "title": "X-Mortise-Tenant"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseList"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "My Cases"
      }
    },
