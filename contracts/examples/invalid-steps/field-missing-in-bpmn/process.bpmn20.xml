<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="https://mortise-dx/workflow">
  <process id="invalid-steps" isExecutable="true">
    <startEvent id="submitted"/>
    <sequenceFlow id="toReview" sourceRef="submitted" targetRef="review"/>
    <userTask id="review" flowable:candidateGroups="manager">
      <extensionElements>
        <flowable:formProperty id="comment"/>
      </extensionElements>
    </userTask>
    <sequenceFlow id="toDone" sourceRef="review" targetRef="done"/>
    <endEvent id="done"/>
  </process>
</definitions>
