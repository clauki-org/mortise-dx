#
# Chép thành /etc/mortise/deploy.env trên máy chủ demo; mortise-deploy.service và deploy/pull-deploy.sh cùng đọc tệp
# này. Không chứa bí mật: bí mật của lõi nằm trong .env của thư mục clone.

# Thư mục clone của repo, thuộc tài khoản chạy dịch vụ.
MORTISE_DIR=/opt/mortise-dx
# Để trống: chạy GitHub Release mới nhất không phải bản thử. Đặt một tag (ví dụ v0.1.0) để giữ máy chủ ở đúng bản đó.
MORTISE_PIN=
# Registry và tên image tự viết mà CI đẩy cho mỗi tag (.github/workflows/release.yml); pull-deploy.sh ghi vào .env.
MORTISE_IMAGE_PREFIX=ghcr.io/clauki-org/mortise-dx
# Gói Tầng 3 cài và smoke sau mỗi lần triển khai, cách nhau dấu cách.
MORTISE_APPS="facilities-commune supplies-commune"
# Nơi `make backup` ghi bản sao lưu trước mỗi lần triển khai; chứa bí mật, chỉ tài khoản chạy dịch vụ đọc được.
BACKUP_DIR=/var/backups/mortise-dx
STATE_DIR=/var/lib/mortise-deploy
# make smoke cần uv; systemd không đọc PATH của shell đăng nhập.
PATH=/home/mortise/.local/bin:/usr/local/bin:/usr/bin:/bin
