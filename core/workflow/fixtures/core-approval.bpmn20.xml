Quy trình mẫu chỉ dùng để kiểm thử lõi, không phải quy trình nghiệp vụ; quy trình
nghiệp vụ nằm trong gói ở apps/. Một người gửi yêu cầu, một người có vai trò manager
trong cùng tenant duyệt hoặc từ chối. Task duyệt có category "four-eyes": lớp
workflow-api không cho người gửi tự duyệt yêu cầu của mình. `make smoke` dựa vào quy
trình này để kiểm cách ly tenant, phân quyền theo vai trò và quy tắc bốn mắt.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="https://mortise-dx/workflow">
  <process id="core-approval" name="Duyệt yêu cầu" isExecutable="true">
    <!-- Biến initiator do workflow-api đặt bằng `sub` của token, không lấy từ tài khoản kỹ thuật của Flowable. -->
    <startEvent id="submitted"/>
    <sequenceFlow id="toReview" sourceRef="submitted" targetRef="review"/>

    <!-- Hạn 3 ngày để `make smoke` kiểm được trường `due` của task. -->
    <userTask id="review" name="Duyệt yêu cầu" flowable:candidateGroups="manager" flowable:category="four-eyes"
              flowable:dueDate="P3D"/>
    <sequenceFlow id="toDecision" sourceRef="review" targetRef="decision"/>

    <exclusiveGateway id="decision" default="toRejected"/>
    <sequenceFlow id="toApproved" sourceRef="decision" targetRef="approved">
      <conditionExpression xsi:type="tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${execution.getVariable("approved") == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="toRejected" sourceRef="decision" targetRef="rejected"/>

    <endEvent id="approved" name="Đã duyệt"/>
    <endEvent id="rejected" name="Từ chối"/>
  </process>
</definitions>
