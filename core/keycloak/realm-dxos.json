{
  "realm": "dxos",
  "displayName": "Mortise DX",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "user", "description": "Người dùng nghiệp vụ trong một tenant" },
      { "name": "manager", "description": "Quản lý, được duyệt trong quy trình" },
      { "name": "tenant_admin", "description": "Quản trị một tenant" }
    ]
  },
  "groups": [
    { "name": "xuong-a" },
    { "name": "xuong-b" }
  ],
  "clients": [
    {
      "clientId": "dxos-web",
      "name": "DX-OS web apps",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
