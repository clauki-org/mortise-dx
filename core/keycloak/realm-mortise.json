{
  "realm": "mortise",
  "displayName": "Mortise DX",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionMaxLifespan": 36000,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "webAuthnPolicyPasswordlessRpEntityName": "Mortise DX",
  "webAuthnPolicyPasswordlessResidentKey": "required",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessPasskeysEnabled": false,
  "browserFlow": "browser-mfa",
  "directGrantFlow": "direct-grant-mfa",
  "authenticationFlows": [
    {
      "alias": "browser-mfa",
      "description": "Đăng nhập trên trình duyệt; người có vai trò otp_required (mọi manager) nhập thêm mã OTP (ADR 0011)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "requirement": "ALTERNATIVE", "priority": 10, "authenticatorFlow": false },
        { "flowAlias": "browser-mfa forms", "requirement": "ALTERNATIVE", "priority": 20, "authenticatorFlow": true }
      ]
    },
    {
      "alias": "browser-mfa forms",
      "description": "Mật khẩu hay Passkey, chặn Passkey của tenant chưa cho phép, rồi OTP nếu có otp_required (ADR 0042)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "flowAlias": "browser-mfa first factor", "requirement": "REQUIRED", "priority": 10, "authenticatorFlow": true },
        { "flowAlias": "browser-mfa passkey policy", "requirement": "CONDITIONAL", "priority": 15, "authenticatorFlow": true },
        { "flowAlias": "browser-mfa approver otp", "requirement": "CONDITIONAL", "priority": 20, "authenticatorFlow": true }
      ]
    },
    {
      "alias": "browser-mfa first factor",
      "description": "Yếu tố đầu: mật khẩu (amr pwd) hay Passkey không cần tên đăng nhập (amr hwk), chọn qua Try Another Way",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form", "requirement": "ALTERNATIVE", "priority": 10,
          "authenticatorFlow": false, "authenticatorConfig": "amr-pwd"
        },
        {
          "authenticator": "webauthn-authenticator-passwordless", "requirement": "ALTERNATIVE", "priority": 20,
          "authenticatorFlow": false, "authenticatorConfig": "amr-hwk"
        }
      ]
    },
    {
      "alias": "browser-mfa passkey policy",
      "description": "Từ chối khi vừa đăng nhập bằng Passkey mà không có vai trò passkey_allowed (tenant chưa bật Passkey)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-credential", "requirement": "REQUIRED", "priority": 10,
          "authenticatorFlow": false, "authenticatorConfig": "passkey-used"
        },
        {
          "authenticator": "conditional-user-role", "requirement": "REQUIRED", "priority": 20,
          "authenticatorFlow": false, "authenticatorConfig": "passkey-not-allowed"
        },
        {
          "authenticator": "deny-access-authenticator", "requirement": "REQUIRED", "priority": 30,
          "authenticatorFlow": false, "authenticatorConfig": "passkey-denied"
        }
      ]
    },
    {
      "alias": "browser-mfa approver otp",
      "description": "OTP bắt buộc với vai trò otp_required; chưa cài thì Keycloak yêu cầu cài ngay lúc đăng nhập",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role", "requirement": "REQUIRED", "priority": 10,
          "authenticatorFlow": false, "authenticatorConfig": "approver-role"
        },
        {
          "authenticator": "auth-otp-form", "requirement": "REQUIRED", "priority": 20,
          "authenticatorFlow": false, "authenticatorConfig": "amr-otp"
        }
      ]
    },
    {
      "alias": "direct-grant-mfa",
      "description": "Lấy token bằng mật khẩu (chỉ client kiểm thử bật); người duyệt gửi kèm mã OTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "direct-grant-validate-username", "requirement": "REQUIRED", "priority": 10, "authenticatorFlow": false },
        {
          "authenticator": "direct-grant-validate-password", "requirement": "REQUIRED", "priority": 20,
          "authenticatorFlow": false, "authenticatorConfig": "amr-pwd"
        },
        { "flowAlias": "direct-grant-mfa approver otp", "requirement": "CONDITIONAL", "priority": 30, "authenticatorFlow": true }
      ]
    },
    {
      "alias": "direct-grant-mfa approver otp",
      "description": "OTP bắt buộc với vai trò otp_required",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role", "requirement": "REQUIRED", "priority": 10,
          "authenticatorFlow": false, "authenticatorConfig": "approver-role"
        },
        {
          "authenticator": "direct-grant-validate-otp", "requirement": "REQUIRED", "priority": 20,
          "authenticatorFlow": false, "authenticatorConfig": "amr-otp"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    { "alias": "approver-role", "config": { "condUserRole": "mortise-web.otp_required", "negate": "false" } },
    { "alias": "amr-pwd", "config": { "default.reference.value": "pwd", "default.reference.maxAge": "36000" } },
    { "alias": "amr-otp", "config": { "default.reference.value": "otp", "default.reference.maxAge": "36000" } },
    { "alias": "amr-hwk", "config": { "default.reference.value": "hwk", "default.reference.maxAge": "36000" } },
    { "alias": "passkey-used", "config": { "credentials": "webauthn-passwordless", "included": "true" } },
    { "alias": "passkey-not-allowed", "config": { "condUserRole": "mortise-web.passkey_allowed", "negate": "true" } },
    {
      "alias": "passkey-denied",
      "config": { "denyErrorMessage": "Đơn vị của tài khoản này chưa cho đăng nhập bằng Passkey. Hãy đăng nhập bằng mật khẩu." }
    }
  ],
  "roles": {
    "realm": [
      { "name": "user", "description": "Người dùng nghiệp vụ trong một tenant" },
      {
        "name": "manager", "description": "Quản lý, được duyệt trong quy trình; gộp otp_required nên luôn phải nhập OTP",
        "composite": true, "composites": { "client": { "mortise-web": ["otp_required"] } }
      },
      { "name": "tenant_admin", "description": "Quản trị một tenant" },
      { "name": "rollup_reader", "description": "Đọc số liệu tổng hợp của các tenant con (ADR 0016)" }
    ],
    "client": {
      "mortise-web": [
        {
          "name": "otp_required",
          "description": "Phải nhập OTP khi đăng nhập (ADR 0011, ADR 0028). Vai trò của client, không của realm: không vào realm_access nên Hasura và workflow-api không coi là vai trò"
        },
        {
          "name": "passkey_allowed",
          "description": "Được đăng nhập bằng Passkey (ADR 0042); gán cho group của tenant bằng make tenant-login. Vai trò của client, không dùng để phân quyền dữ liệu"
        }
      ]
    }
  },
  "groups": [
    { "name": "xa-a" },
    { "name": "xa-b" },
    { "name": "xa-c" },
    { "name": "tinh-mau" },
    { "name": "tinh-khac" }
  ],
  "clients": [
    {
      "clientId": "mortise-web",
      "name": "Mortise DX web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["${MORTISE_PUBLIC_URL}/*"],
      "webOrigins": ["${MORTISE_PUBLIC_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${MORTISE_PUBLIC_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ]
}
