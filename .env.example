#
# Sao chép thành .env bằng `make env` (tự sinh bí mật ngẫu nhiên).
# Không commit file .env.

# URL công khai mà trình duyệt dùng để vào cổng APISIX.
MORTISE_PUBLIC_URL=http://localhost:9080
# Địa chỉ bind cổng 9080 trên máy chủ (0.0.0.0 để mở cho mạng ngoài).
MORTISE_BIND=127.0.0.1

POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
HASURA_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
HASURA_ADMIN_SECRET=change-me
FLOWABLE_DB_PASSWORD=change-me
FLOWABLE_ADMIN_PASSWORD=change-me
FILES_DB_PASSWORD=change-me
# Mật khẩu CSDL riêng của Scorpio (broker NGSI-LD).
SCORPIO_DB_PASSWORD=change-me
# Cầu nối MQTT sang Scorpio: tài khoản Mosquitto và vai trò CSDL chỉ đọc core.tenants.
MQTT_BRIDGE_PASSWORD=change-me
IOT_BRIDGE_DB_PASSWORD=change-me
# Vai trò CSDL của trợ lý hỏi văn bản, chỉ được thêm dòng vào nhật ký câu hỏi.
ASSISTANT_DB_PASSWORD=change-me
# Nhà cung cấp mô hình của trợ lý: để trống là Ollama tại chỗ. `openai-compatible` gửi câu hỏi và các câu đã tìm ra
# API ngoài (ADR 0021): khai cả địa chỉ (phần trước /chat/completions), tên mô hình và khóa. Không sinh tự động.
ASSISTANT_LLM_PROVIDER=
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_MODEL=
ASSISTANT_LLM_API_KEY=
# Vai trò CSDL của workflow-api, chỉ đọc bảng phân cấp thẩm quyền và bảng tenant (ADR 0028).
WORKFLOW_DB_PASSWORD=change-me
# Secret của client Keycloak mortise-iot-bridge (tài khoản dịch vụ mở hồ sơ khi vượt ngưỡng), do `make seed` đặt.
IOT_BRIDGE_CLIENT_SECRET=change-me
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
# Mật khẩu chung cho các tài khoản demo do `make seed` tạo.
DEMO_USER_PASSWORD=change-me
# Khóa OTP chung của các tài khoản demo phải nhập OTP (manager.*, admin2.a, user.k), do `make seed` gắn; `make otp`
# in mã hiện tại.
DEMO_OTP_SECRET=change-me
# Mật khẩu tài khoản `admin` của Grafana (profile observability, `make obs-up`); chỉ áp dụng lần đầu Grafana chạy.
GRAFANA_ADMIN_PASSWORD=change-me
# Truy vết phân tán (ADR 0038): `on` lưu vết của mọi yêu cầu qua /v1 vào Jaeger của profile observability (`make
# obs-up`), `off` tắt. Chỉ nhận on hoặc off; đổi xong chạy `make up` để dựng lại cổng và dịch vụ.
MORTISE_TRACING=off
# Thư mục thương hiệu của bản cài (ADR 0043): branding.json theo contracts/branding.schema.json và logo, logo khai
# là /brand/<tệp>. Đổi tệp trong thư mục là trang tải sau thấy ngay, không cần dựng lại image.
MORTISE_BRANDING_DIR=./platform/web/brand
# Thư mục nền bản đồ (ADR 0056), nơi `make basemap` ghi tệp PMTiles cắt từ OpenStreetMap và web phục vụ ở /basemap/.
# Bỏ trống là ~/.cache/mortise-dx/basemap của người chạy lệnh; đặt ngoài repo vì là dữ liệu tải về. Ví dụ:
# MORTISE_BASEMAP_DIR=/srv/mortise/basemap
# Mật khẩu MQTT chung của các thiết bị demo (devices/simulator/devices.yaml), do `make seed` cấp.
DEMO_DEVICE_PASSWORD=change-me

# Cổng quản trị chỉ bind 127.0.0.1.
PG_PORT=55432
KEYCLOAK_ADMIN_PORT=8081
HASURA_PORT=8082
FLOWABLE_PORT=8083
S3_PORT=8333
SCORPIO_PORT=9090
# Grafana của profile observability, chỉ bind 127.0.0.1.
GRAFANA_PORT=3000
